# vol-engine configuration (copy to .env and export; never commit real values).
DATABASE_URL=postgres://lemniscate:lemniscate@localhost:5432/lemniscate
# Signer for VolOracle posts: an encrypted keystore plus a password file (the only form NODE_ENV=production accepts) ...
VOL_SIGNER_KEYSTORE=
VOL_SIGNER_KEYSTORE_PASSWORD_FILE=
# ... or a raw key for local development only. Set it in the process environment only.
VOL_SIGNER_KEY=
# VolOracle address and chain id for the EIP-712 domain.
VOL_ORACLE_ADDRESS=
VOL_CHAIN_ID=4663
# Sending is OFF unless this is exactly 1. Needs VOL_RPC_URL and a gas payer key (VOL_SENDER_KEY, defaults to the signer key).
VOL_SEND=0
VOL_RPC_URL=
# Same two forms for the sender: VOL_SENDER_KEYSTORE + VOL_SENDER_KEYSTORE_PASSWORD_FILE.
VOL_SENDER_KEY=
# Optional JSON history files (see README).
VOL_MOVES_FILE=
VOL_WEEKEND_FILE=
# Optional name=address overrides; by default the address comes from ticks.name / ticks.stock_token.
VOL_STOCKS=
