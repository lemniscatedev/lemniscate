# Settings for every Lemniscate service on the server. provision.sh copies this to /etc/lemniscate/lemniscate.env
# (root, 0600) on the first run. deploy.sh refuses to start anything while a CHANGE_ME or GENERATED_BY_PROVISION is left.
# DATABASE_URL and POSTGRES_PASSWORD come from /etc/lemniscate/db.env (written by provision.sh): do not set them here.
#
# KEYS are not set here. Signing keys live only as encrypted keystore files in /etc/lemniscate/keys (<role>.json plus
# <role>.password, group lemniscate, mode 0440). Each service's unit points at its own keystore (KEEPER_KEYSTORE and so on)
# and decrypts it in its own process; NODE_ENV=production below refuses a raw key and a key file other users can read.
# Roles: keeper, hedger, vol-signer (required) and paymaster-signer, x402-settler (optional). The owner wallet is never on
# a server. deploy.sh refuses a raw *_PRIVATE_KEY / *_SIGNER_KEY / *_SETTLER_KEY / AGENT_KEY line in this file.
# Per-service overrides go in /etc/lemniscate/<service>.env (api.env, keeper.env, hedger.env, vol-engine.env, mcp.env).

# ---- network (mainnet only; deploy.sh checks the RPC answers chain id 4663)
NODE_ENV=production
NETWORK=mainnet
CHAIN_ID=4663
LOG_LEVEL=info
PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional free Alchemy keys (comma separated). Empty = the public RPC only.
ALCHEMY_API_KEYS=
# Where the deployment file of this release is (deploy.sh ships it as app/deployments/4663.json).
DEPLOYMENT_FILE=/opt/lemniscate/current/app/deployments/4663.json

# ---- data sources (free key from alphavantage.co; empty = the earnings and reference imports stay off)
ALPHAVANTAGE_API_KEY=CHANGE_ME

# ---- api (Caddy serves it at https://api.<domain>)
API_PORT=3101
# Every origin that may call the API from a browser: the website domain(s), comma separated.
CORS_ORIGINS=CHANGE_ME
API_RATE_LIMIT_PER_MINUTE=300
# Caddy sets X-Forwarded-For to the real client address and removes Cloudflare headers a client could forge.
API_CLIENT_IP_HEADER=x-forwarded-for
# Closed beta: 1 = a wallet must redeem an invite code before the API builds buy or Shield calldata (sells are never gated).
# The app_settings row set by scripts/invites/verify.ts overrides this live, no restart.
INVITES_REQUIRED=0

# ---- account abstraction (one-tap). Both empty = no gas sponsoring. If set, the paymaster-signer keystore must exist.
BUNDLER_URL=
PAYMASTER_ADDRESS=
PAYMASTER_VALIDITY_SECONDS=300
# The paymaster's on-chain globalDailyCap (runbooks deploy-config .paymaster.globalDailyCapWei). The API warns at startup when
# (SPONSOR_ENTRY_GLOBAL_DAILY + SPONSOR_EXIT_GLOBAL_DAILY) x PAYMASTER_MAX_COST_PER_OP_WEI could exceed it.
PAYMASTER_GLOBAL_DAILY_CAP_WEI=250000000000000000

# ---- x402 pay-per-call data: OFF at launch (decision 20). To turn on later: X402_ENABLED=1, X402_PAY_TO (a Safe),
# prices, and the x402-settler keystore. Leave these commented until then.
# X402_ENABLED=1
# X402_PAY_TO=CHANGE_ME

# ---- keeper (role keeper)
KEEPER_ENABLED_JOBS=sessions,lister,accrue,risk,corp-actions,receipts,reference,earnings,queued-sells,fee-distribute,settle-halted,staking-sync,kernel-register,admin-watch
KEEPER_DRY_RUN=0

# ---- hedger (role hedger). Dry run: it simulates and reports, and never trades, until HEDGER_DRY_RUN=0.
HEDGER_DRY_RUN=1
# Not used since the hedger calls pool.rebalance (the pool holds the spot hedge and its adapter); leave empty.
HEDGER_ADAPTER_ADDRESS=
HEDGER_PERP_ENABLED=0

# ---- vol-engine (role vol-signer). Sending is off until VOL_SEND=1.
VOL_SEND=0
VOL_ORACLE_ADDRESS=CHANGE_ME
VOL_CHAIN_ID=4663
VOL_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VOL_VALIDITY_S=3600
VOL_MOVES_FILE=/opt/lemniscate/current/app/config/vol-moves.json
VOL_WEEKEND_FILE=/opt/lemniscate/current/app/config/vol-weekend.json
# Seconds between vol-engine passes.
VOL_INTERVAL_SECONDS=300

# ---- mcp (off by default: systemctl enable --now lemniscate-mcp, then set mcp_domain and re-run provision.sh)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3102
LMNS_API_URL=http://127.0.0.1:3101
MCP_RATE_LIMIT_PER_MINUTE=60
# Leave unset: the server's MCP is read-only. An agent key never goes on this server.
