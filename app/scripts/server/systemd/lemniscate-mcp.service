# Lemniscate mcp: read-only agent tools over MCP, HTTP on localhost
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with lemniscate.target.
# OFF by default: deploy.sh only enables it if it is already enabled (systemctl enable lemniscate-mcp). Read-only: no agent key.
[Unit]
Description=Lemniscate mcp, read-only agent tools over MCP, HTTP on localhost
Documentation=file:/opt/lemniscate/current/app/scripts/server/README.md
PartOf=lemniscate.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lem-mcp
Group=lem-mcp
WorkingDirectory=/opt/lemniscate/current/app
Environment=HOME=/var/lib/lemniscate/mcp
EnvironmentFile=/etc/lemniscate/lemniscate.env
EnvironmentFile=/etc/lemniscate/db.env
EnvironmentFile=-/etc/lemniscate/mcp.env
ExecStart=/usr/local/bin/bun src/bin/mcp.ts --http
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lemniscate-mcp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lemniscate/mcp
UMask=0077
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=lemniscate.target
