# Lemniscate api: read API, signed actions, one-tap user operations
# Installed to /etc/systemd/system by provision.sh and deploy.sh; restarted and stopped with lemniscate.target.
# The two keys are optional (paymaster sponsoring; x402 stays off at launch): deploy.sh writes /etc/lemniscate/api-keys.env
# with the keystore and password file paths of each one whose keystore exists. The service decrypts them itself.
[Unit]
Description=Lemniscate api, read API, signed actions, one-tap user operations
Documentation=file:/opt/lemniscate/current/app/scripts/server/README.md
PartOf=lemniscate.target
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lem-api
Group=lem-api
WorkingDirectory=/opt/lemniscate/current/app
Environment=HOME=/var/lib/lemniscate/api
EnvironmentFile=/etc/lemniscate/lemniscate.env
EnvironmentFile=/etc/lemniscate/db.env
EnvironmentFile=-/etc/lemniscate/api.env
EnvironmentFile=-/etc/lemniscate/api-keys.env
ExecStart=/usr/local/bin/bun src/bin/api.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=768M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lemniscate-api
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lemniscate/api
UMask=0077
PrivateDevices=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=lemniscate.target
