# Runs lemniscate-backup.service every night at 03:15 (server time). Persistent: a run missed while the server was off
# happens at the next boot. List with: systemctl list-timers lemniscate-backup.timer
[Unit]
Description=Nightly Lemniscate database backup

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
