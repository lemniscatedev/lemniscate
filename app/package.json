{
  "name": "lemniscate-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "api": "bun run src/bin/api.ts",
    "smoke": "bun run scripts/smoke.ts",
    "indexer": "bun run src/bin/indexer.ts",
    "keeper": "bun run src/bin/keeper.ts",
    "mcp": "bun run src/bin/mcp.ts",
    "mcp:http": "bun run src/bin/mcp.ts --http",
    "migrate": "bun run src/bin/migrate.ts",
    "seed-vol-history": "bun run scripts/seed-vol-history.ts",
    "sync-abi": "bun run scripts/sync-abi.ts",
    "sync-abi:check": "bun run scripts/sync-abi.ts --check",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "lint:copy": "bun run scripts/lint-copy.ts",
    "rpc-pool:check": "bun run src/chain/rpc-pool.check.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.11",
    "pino": "9.14.0",
    "postgres": "3.4.9",
    "viem": "2.57.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
