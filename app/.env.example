# Example environment for the LEMNISCATE services (api, indexer, keeper, migrate).
# Copy to .env and fill in real values; never commit the filled-in file.
# Every variable read by src/config.ts is listed; defaults are shown where the
# schema has one.

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development
# mainnet | fork
NETWORK=fork
CHAIN_ID=4663
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (required) -----------------------------------------------------
DATABASE_URL=postgres://lemniscate:change-me@127.0.0.1:5432/lemniscate
POSTGRES_PASSWORD=change-me

# --- RPC ---------------------------------------------------------------------
# Comma-separated Alchemy API keys; leave empty to use the public RPC only.
ALCHEMY_API_KEYS=
ALCHEMY_URL_TEMPLATE=https://robinhood-mainnet.g.alchemy.com/v2/{key}
PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Single endpoint that replaces all others (e.g. a local Anvil fork).
RPC_URL_OVERRIDE=
# Endpoint order per call class: public and/or alchemy, comma-separated.
RPC_ROUTE_LOGS=public,alchemy
RPC_ROUTE_STATE=public,alchemy
RPC_ROUTE_TX=alchemy,public

# --- Deployment --------------------------------------------------------------
DEPLOYMENT_FILE=/app/deployments/fork.json

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_ACTIVE_MS=5000
INDEXER_POLL_BASE_MS=15000
INDEXER_POLL_IDLE_MS=60000

# --- Keeper ------------------------------------------------------------------
KEEPER_ENABLED_JOBS=sessions,lister,accrue,risk,corp-actions,receipts,reference,earnings
# 1 simulates without broadcasting
KEEPER_DRY_RUN=0
# Accrue a series once its last accrual is this old and somebody holds it (seconds, 300 to 3600).
KEEPER_ACCRUE_MAX_AGE_SECONDS=3600
# Series per accrueMany transaction (a failing batch is split and retried).
KEEPER_ACCRUE_BATCH=40
# Listing/archive transactions per lister run.
KEEPER_LISTER_MAX_TX=60
# Seconds between two automatic pauses for the same reason.
KEEPER_RISK_COOLDOWN_SECONDS=3600
# Every signer takes ONE of two forms (the API, indexer and migrate strip the keeper's at startup):
#   <PREFIX>_KEYSTORE=/path/keeper.json  +  <PREFIX>_KEYSTORE_PASSWORD_FILE=/path/keeper.password   (encrypted; the only form
#       NODE_ENV=production accepts, and the files must not be readable by other users)
#   KEEPER_PRIVATE_KEY=0x..  (0x-prefixed 32-byte hex; local development only, never on a server)
# The same pattern holds for HEDGER (HEDGER_PRIVATE_KEY), VOL_SIGNER (VOL_SIGNER_KEY), VOL_SENDER (VOL_SENDER_KEY),
# PAYMASTER_SIGNER (PAYMASTER_SIGNER_KEY), X402_SETTLER (X402_SETTLER_KEY) and AGENT (AGENT_KEY).
# The keeper, the hedger and the vol signer must be three different keys: the keeper refuses to start if any two are the same.
KEEPER_KEYSTORE=
KEEPER_KEYSTORE_PASSWORD_FILE=
KEEPER_PRIVATE_KEY=

# --- API ---------------------------------------------------------------------
API_PORT=3101
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:7200
# Per-client-IP requests per minute (0 disables).
API_RATE_LIMIT_PER_MINUTE=300
# Header carrying the real client IP from the fronting proxy (Cloudflare Tunnel).
API_CLIENT_IP_HEADER=cf-connecting-ip

# --- Agents: MCP server (bun run mcp, or mcp:http) ---------------------------
# Base URL of the REST API the MCP tools call.
LMNS_API_URL=http://127.0.0.1:3101
# Agent signing key (AGENT_KEYSTORE + AGENT_KEYSTORE_PASSWORD_FILE, or AGENT_KEY = 0x + 64 hex for development). Unset = read-only server (quote and read, no trading). Never commit a value.
AGENT_KEY=
# The account whose funds the agent may use (the owner who called AgentRouter.setPolicy for this agent).
AGENT_OWNER=
# AgentRouter address; empty = taken from /v1/config contracts.agentRouter.
AGENT_ROUTER=
AGENT_RPC_URL=https://rpc.mainnet.chain.robinhood.com
AGENT_CHAIN_ID=4663
# Client-side mirror of the owner's policy, JSON, raw USDG (6 dp). The contract stays the authority.
# {"owner":"0x..","budgetUsdg":"50000000","spentUsdg":"0","maxPerTradeUsdg":"20000000","expiresAt":1800000000,"canSell":true,"canShield":false,"stocks":["0x.."]}
AGENT_POLICY=
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3102
# Required to serve HTTP with an agent key (16+ characters).
MCP_HTTP_TOKEN=
MCP_ALLOWED_ORIGINS=
# Most the agent will sign for one paid data call (USDG).
X402_MAX_PER_CALL_USDG=0.02

# --- x402 pay-per-call data (API process; off by default) ---------------------
X402_ENABLED=0
# Receives the USDG.
X402_PAY_TO=
# Submits Permit2 settlements and pays their gas (a separate hot wallet holding gas only). Or X402_SETTLER_KEYSTORE + X402_SETTLER_KEYSTORE_PASSWORD_FILE.
X402_SETTLER_KEY=
X402_RPC_URL=
# Optional hex secret so challenges survive a restart or span instances.
X402_NONCE_SECRET=
X402_CHALLENGE_TTL_SECONDS=300
# Browser origins that read paid routes free (the website). Spoofable by non-browser clients: a soft exemption.
X402_FREE_ORIGINS=
# Prices in USDG per call (0.001 to 0.01 by default).
X402_PRICE_VOL=0.002
X402_PRICE_CHAINS=0.005
X402_PRICE_POOL=0.003
